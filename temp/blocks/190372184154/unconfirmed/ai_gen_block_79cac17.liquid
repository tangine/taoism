{% doc %}
  @prompt
    一张产品卡，顶部是产品图片，下方是价格和标题。添加平滑的全息微光效果和阴影。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-card-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-product-card-wrapper-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 {{ block.settings.shadow_offset }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-wrapper-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.shadow_offset | plus: 4 }}px {{ block.settings.shadow_blur | plus: 8 }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | plus: 0.1 }});
  }

  .ai-product-card-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-card-image-container-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-card-shimmer-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      110deg,
      transparent 0%,
      transparent 40%,
      rgba(255, 255, 255, 0.3) 45%,
      rgba(147, 197, 253, 0.4) 48%,
      rgba(196, 181, 253, 0.4) 50%,
      rgba(251, 207, 232, 0.4) 52%,
      rgba(255, 255, 255, 0.3) 55%,
      transparent 60%,
      transparent 100%
    );
    background-size: 200% 100%;
    pointer-events: none;
    opacity: {{ block.settings.shimmer_opacity }};
  }

  .ai-product-card-wrapper-{{ ai_gen_id }}:hover .ai-product-card-shimmer-{{ ai_gen_id }} {
    animation: ai-shimmer-{{ ai_gen_id }} {{ block.settings.shimmer_duration }}s ease-in-out infinite;
  }

  @keyframes ai-shimmer-{{ ai_gen_id }} {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.spacing }}px 0;
    line-height: 1.3;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-product-card-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | times: 0.9 }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    margin-left: 8px;
    opacity: 0.7;
  }

  .ai-product-card-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-product-card-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<product-card-{{ ai_gen_id }} class="ai-product-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.product != blank %}
    <a href="{{ block.settings.product.url }}" class="ai-product-card-link-{{ ai_gen_id }}">
      <div class="ai-product-card-wrapper-{{ ai_gen_id }}">
        <div class="ai-product-card-image-container-{{ ai_gen_id }}">
          {% if block.settings.product.featured_image %}
            <img
              src="{{ block.settings.product.featured_image | image_url: width: 800 }}"
              alt="{{ block.settings.product.featured_image.alt | escape }}"
              class="ai-product-card-image-{{ ai_gen_id }}"
              loading="lazy"
              width="800"
              height="{{ 800 | divided_by: block.settings.product.featured_image.aspect_ratio | round }}"
            >
          {% else %}
            <div class="ai-product-card-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-product-card-shimmer-{{ ai_gen_id }}"></div>
        </div>
        
        <div class="ai-product-card-content-{{ ai_gen_id }}">
          {% if block.settings.show_title %}
            <h3 class="ai-product-card-title-{{ ai_gen_id }}">
              {{ block.settings.product.title }}
            </h3>
          {% endif %}
          
          {% if block.settings.show_price %}
            <div class="ai-product-card-price-{{ ai_gen_id }}">
              {{ block.settings.product.price | money }}
              {% if block.settings.product.compare_at_price > block.settings.product.price %}
                <span class="ai-product-card-compare-price-{{ ai_gen_id }}">
                  {{ block.settings.product.compare_at_price | money }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </a>
  {% else %}
    <div class="ai-product-card-wrapper-{{ ai_gen_id }}">
      <div class="ai-product-card-image-container-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
        <div class="ai-product-card-shimmer-{{ ai_gen_id }}"></div>
      </div>
      
      <div class="ai-product-card-content-{{ ai_gen_id }}">
        {% if block.settings.show_title %}
          <h3 class="ai-product-card-title-{{ ai_gen_id }}">
            产品标题
          </h3>
        {% endif %}
        
        {% if block.settings.show_price %}
          <div class="ai-product-card-price-{{ ai_gen_id }}">
            HKD $99.00
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
</product-card-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('product-card-{{ ai_gen_id }}', ProductCard{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "产品卡",
  "settings": [
    {
      "type": "header",
      "content": "产品"
    },
    {
      "type": "product",
      "id": "product",
      "label": "产品"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "显示标题",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "显示价格",
      "default": true
    },
    {
      "type": "header",
      "content": "图片"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "图片比例",
      "options": [
        {
          "value": "1/1",
          "label": "方形 (1:1)"
        },
        {
          "value": "3/4",
          "label": "竖向 (3:4)"
        },
        {
          "value": "4/3",
          "label": "横向 (4:3)"
        },
        {
          "value": "16/9",
          "label": "宽屏 (16:9)"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "header",
      "content": "全息微光效果"
    },
    {
      "type": "range",
      "id": "shimmer_opacity",
      "label": "微光不透明度",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.6
    },
    {
      "type": "range",
      "id": "shimmer_duration",
      "label": "微光速度",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "unit": "s",
      "default": 2
    },
    {
      "type": "header",
      "content": "阴影"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "label": "阴影偏移",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "阴影模糊",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "阴影不透明度",
      "min": 0,
      "max": 0.5,
      "step": 0.1,
      "default": 0.2
    },
    {
      "type": "range",
      "id": "hover_lift",
      "label": "悬停上升",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "样式"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "卡片背景",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "圆角",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "内容内边距",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "元素间距",
      "min": 4,
      "max": 24,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "标题"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "标题大小",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "标题粗细",
      "options": [
        {
          "value": "400",
          "label": "正常"
        },
        {
          "value": "500",
          "label": "中等"
        },
        {
          "value": "600",
          "label": "半粗"
        },
        {
          "value": "700",
          "label": "粗体"
        }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "价格"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "价格大小",
      "min": 12,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "价格粗细",
      "options": [
        {
          "value": "400",
          "label": "正常"
        },
        {
          "value": "500",
          "label": "中等"
        },
        {
          "value": "600",
          "label": "半粗"
        },
        {
          "value": "700",
          "label": "粗体"
        }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "价格颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "对比价格颜色",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "产品卡"
    }
  ]
}
{% endschema %}
