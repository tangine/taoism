</div>

{% schema %}
{
  "name": "t:names.slide",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "blocks": [],
  "presets": []
}
{% endschema %}