<div class="slide slide-item">
  <img src="{{ block.settings.background_image | image_url }}" alt="">
</div>

{% schema %}
{
  "name": "t:names.slide",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:names.slide"
    }
  ]
}
{% endschema %}