<div>
  {% render 'variant-picker' %}
</div>

{% schema %}
{
  "name": "t:blocks.variant_picker",
  "settings": [
    {
      "type": "range",
      "id": "thickness",
      "label": "t:settings.thickness",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:blocks.variant_picker",
      "category": "t:categories.product",
    }
  ]
}
{% endschema %}