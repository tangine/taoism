{% liquid
  assign product = product | default: closest.product
%}

<h1>{{ product.title }}</h1>

{% schema %}
{
  "name": "t:blocks.product_title",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:blocks.product_title",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}