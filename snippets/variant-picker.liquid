{% liquid
  assign product = product | default: closest.product
%}

{% unless product.has_only_default_variant %}
  <variant-picker>
    <script type="module" src="{{ 'variant-picker.js' | asset_url }}"></script>
    {% for product_option in product.options_with_values %}
      <fieldset>
        <legend>{{ product_option.name }}</legend>
        {% for option_value in product_option.values %}
          <label>
            <input type="radio"
                   name="{{ product_option.name }}"
                   value="{{ option_value.name }}"
                   data-id="{{ option_value.id }}"
                   data-name="{{ product_option.name }}"
                   data-value="{{ option_value.name }}"
            {% if option_value.selected %}
              checked data-checked="true"
            {% else %}
              data-checked="false"
              {% endif %}>
            <span>{{ option_value.name }}</span>
          </label>
        {% endfor %}
      </fieldset>
    {% endfor %}
  </variant-picker>
{% endunless %}