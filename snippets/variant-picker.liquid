{% liquid
  assign product = product | default: closest.product
  assign current_variant = product | default: closest.product.selected_or_first_available_variant
  assign selected_options_index = ""
  assign separator = ","
%}

{% unless product.has_only_default_variant %}
  <variant-picker>
    <script type="module" src="{{ 'variant-picker.js' | asset_url }}"></script>

    {% liquid
      for product_option in product.options_with_values
        assign option_index = forloop.index0
        for option_value in product_option.values
          assign value_index = forloop.index0
          if option_value.selected
            if option_index != 0
              assign selected_options_index = selected_options_index | append: separator
            endif
            assign selected_options_index = selected_options_index | append: value_index
          endif
        endfor
      endfor
      assign selected_options_index = selected_options_index | split: separator
      assign end_index = selected_options_index.size | minus: 1
    %}

    <div>{{ selected_options_index }}</div>

    {% for product_option in product.options_with_values %}
      {% liquid assign option_index = forloop.index0 %}
      <fieldset>
        <legend>{{ product_option.name }}</legend>
        {% for option_value in product_option.values %}
          {% liquid
            assign current_options = ""
            assign value_index = forloop.index0

            for index in (0..end_index)
              assign option = ""
              if index != 0
                assign current_options = current_options | append: separator
              endif
              if option_index == index
                assign option = option_value.name
              else
                assign selected_index = selected_options_index[index] | plus: 0
                assign option = product.options_with_values[index].values[selected_index].name
              endif
              assign current_options = current_options | append: option
              assign current_options = current_options | split: separator
            endfor
          %}
          {% for variant in product.variants %}
            <div>{{ current_options }}</div>
            {% for current_option in current_options %}
              <div>{{ current_option }}</div>
              {% if variant.options[forloop.index0] != current_option %}
                {% break %}
              {% elsif forloop.last %}
                {% comment %}<label>{% endcomment %}
                  {% comment %}<input type="radio"{% endcomment %}
                         {% comment %}value="{{ option_value.name }}"{% endcomment %}
                         {% comment %}name="{{ product_option.name }}"{% endcomment %}
                         {% comment %}data-available="{{ variant.available }}"{% endcomment %}
                         {% comment %}data-id="{{ option_value.id }}"{% endcomment %}
                         {% comment %}data-name="{{ product_option.name }}"{% endcomment %}
                         {% comment %}data-value="{{ option_value.name }}"{% endcomment %}
                         {% comment %}{% if option_value.selected %}checked{% endif %}{% endcomment %}
                  {% comment %}/>{% endcomment %}
                  {% comment %}<span>{{ option_value.name }}</span>{% endcomment %}
                {% comment %}</label>{% endcomment %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        {% endfor %}
      </fieldset>
    {% endfor %}
  </variant-picker>
{% endunless %}