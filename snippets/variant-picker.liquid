{% liquid
  assign product = product | default: closest.product
  assign current_variant = product | default: closest.product.selected_or_first_available_variant
  assign selected_options = ""
%}

{% unless product.has_only_default_variant %}
  <variant-picker>
    <script type="module" src="{{ 'variant-picker.js' | asset_url }}"></script>

    {% liquid
      for product_option in product.options_with_values
        assign option_index = forloop.index0
        for option_value in product_option.values
          assign value_index = forloop.index
          if option_value.selected
            if option_index != 0
              assign selected_options = selected_options | append: ","
            endif
            assign selected_options = selected_options | append: value_index
          endif
        endfor
      endfor
    %}

    <div>{{ selected_options }}</div>

    {% for product_option in product.options_with_values %}
      <fieldset>
        <legend>{{ product_option.name }}</legend>
        {% for option_value in product_option.values %}
          <label>
            <input type="radio"
                   name="{{ product_option.name }}"
                   value="{{ option_value.name }}"
                   data-option-id="{{ option_value.id }}"
                   data-option-name="{{ product_option.name }}"
                   data-option-value="{{ option_value.name }}"
            {% if option_value.selected %}
              checked data-checked="true"
            {% else %}
              data-checked="false"
              {% endif %}>
            <span>{{ option_value.name }}</span>
          </label>
        {% endfor %}
      </fieldset>
    {% endfor %}
  </variant-picker>
{% endunless %}