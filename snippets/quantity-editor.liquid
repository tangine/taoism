{% liquid
  assign quantity = quantity | default: 1
  assign min = min | default: 1
  assign step = step | default: 1
%}

<quantity-editor class="quantity">
  <button class="quantity-editor__button quantity-editor__butoon-minus" name="minus" type="button">
    <span class="svg-wrapper">{{ 'icon-minus.svg' | inline_asset_content }}</span>
  </button>
  <input type="number" class="quantity-editor__input" name="quantity" {% unless max == null %} max = "{{ max }}" {% endunless %}
         data-quantity="{{ quantity }}"
         value="{{ quantity }}"
         min="{{ min }}"
         step="{{ step }}"
      />
  <button class="quantity-editor__button quantity-editor__butoon-plus" name="plus" type="button">
    <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
  </button>
</quantity-editor>