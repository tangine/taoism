{%- if paginate.pages > 1 -%}
  <ul class="pagination" role="list">
    <li class="pagination-item pagination-item--prev {% unless paginate.previous %}disabled{% endunless %}">
      <a {% if paginate.previous %}href="{{ paginate.previous.url }}"{% endif %}>
        {% render 'svg-icon', icon: 'icon-chevron-left.svg' %}
      </a>
    </li>

    {%- for part in paginate.parts -%}
      <li class="pagination-item {% if part.title == paginate.current_page %}pagination-item-active{% endif %}">
        {% if part.is_link %}
          <a href="{{ part.url }}">
            {{ part.title }}
          </a>
        {% else %}
          {% if part.title == paginate.current_page %}
            <a role="link" aria-disabled="true">{{ part.title }}</a>
          {% else %}
            <span>{{ part.title }}</span>
          {% endif %}
        {% endif %}
      </li>
    {%- endfor -%}

    <li class="pagination-item pagination-item--next {% unless paginate.next %}disabled{% endunless %}">
      <a {% if paginate.next %}href="{{ paginate.next.url }}"{% endif %}>
        {% render 'svg-icon', icon: 'icon-chevron-right.svg' %}
      </a>
    </li>
  </ul>
{%- endif -%}