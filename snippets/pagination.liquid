{%- if paginate.pages > 1 -%}
    <ul class="pagination" role="list">
      {%- if paginate.previous -%}
        <li class="pagination-item pagination-item--prev">
          <a  href="{{ paginate.previous.url }}">
            {{- 'icon-chevron-left.svg' | inline_asset_content -}}
          </a>
        </li>
      {%- endif -%}



      {%- for part in paginate.parts -%}
        <li class="pagination-item {% if part.title == paginate.current_page %}pagination-item-active{% endif %}">
          {% if part.is_link %}
            <a href="{{ part.url }}">
              {{ part.title }}
            </a>
          {% else %}
            {% if part.title == paginate.current_page %}
              <a role="link" aria-disabled="true">{{ part.title }}</a>
            {% else %}
              <span>{{ part.title }}</span>
            {% endif %}
          {% endif %}
        </li>
  {%- endfor -%}

  {%- if paginate.next -%}
  <li class="pagination-item pagination-item--next">
    <a href="{{ paginate.next.url }}">
      {{- 'icon-chevron-right.svg' | inline_asset_content -}}
    </a>
  </li>
  {%- endif -%}
  </ul>
{%- endif -%}