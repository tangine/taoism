{% liquid
  assign product = product | default: closest.product
  assign image_ratio = image_ratio | default: 1
  assign show_secondary_image = show_secondary_image | default: false
  assign show_vendor = show_vendor | default: false
  assign show_rating = show_rating | default: false
%}

{% stylesheet %}
.product-card {
width: 100%;
position: relative;
}
.product-card .product-card__image {
display: block;
position: relative;
width: 100%;
aspect-ratio: 1/1;
}
.product-card .product-card__image img {
position: absolute;
top: 0;
left: 0;
width: 100%;
height: 100%;
transition: opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.product-card .product-card__image img + img {
opacity: 0;
}
.product-card .product-card__image:hover img + img {
opacity: 1;
transform: scale(1.03);
transition: transform 0.5s ease;
}
{% endstylesheet %}

<div class="product-card">
  <a class="product-card__image">
    {% render 'thumbnail', image: product.featured_image %}
    {% render 'thumbnail', image: product.images[1], class_name: "hover-image" %}
  </a>
  <div class="product-card__info">
    <div class="product-card__title">{{ product.title }}</div>
  </div>
</div>