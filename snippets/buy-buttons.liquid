

{% liquid
  assign product_form_id = "product-form-" | append: section.id
  assign product = product | default: closest.product
%}

<div>
  <product-form>
    {%- form 'product', product, id: product_form_id -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
      <div class="flex-row">
        {% render 'quantity-editor' %}
        <button type="button" name="add-to-cart" style="width: 100%;" {% unless product.selected_or_first_available_variant.available %} disabled {% endunless %}>
          {% if product.selected_or_first_available_variant.available %}
            {{ 'actions.add_to_cart' | t }}
            {% else %}
            {{ 'content.sold_out' | t }}
          {% endif %}
        </button>
      </div>
    {%- endform -%}
  </product-form>
</div>