{% stylesheet %}
  .menu {display: flex;flex-direction: row;}
{% endstylesheet %}

<div>
  {% if section.settings.header_menu %}
    <ul class="menu">
    {% for link in section.settings.header_menu.links %}
      <li class="menu-item">
        <a href="{{ link.url }}">{{ link.title }}</a>
      </li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
{% schema %}
{
  "name": "t:names.header",
  "settings": [
    {
      "type": "link_list",
      "id": "header_menu",
      "label": "t:settings.menu"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:names.header"
    }
  ]
}
{% endschema %}