{% style %}
  #{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top | append : 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append : 'px' }};
  }
{% endstyle %}

<div id="{{ section.id }}" class="relative">
  <div class="section-inner">

    {% paginate collection.products by section.settings.page_size %}
      <ul style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
        {% for product in collection.products %}
          <li>
            {% render 'product-card', product: product, show_secondary_image: true %}
          </li>
        {% endfor %}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</div>
{% schema %}
{
  "name": "t:sections.collection",
  "tag": "section",
  "class": "section product-list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings":  [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "Page Size",
      "default": 12,
      "min": 4,
      "max": 48,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name":  "t:sections.collection"
    }
  ]
}
{% endschema %}