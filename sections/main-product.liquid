{% style %}
  #{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top | append : 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append : 'px' }};
  }
{% endstyle %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
%}

<script type="module" src="{{ 'product-info.js' | asset_url }}"></script>

<div id="{{ section.id }}" class="relative">
  <div class="section-inner">
    <product-info style="display: grid;grid-template-columns: repeat(2,1fr);">
      <div class="media-gallery">
        {% if section.settings.only_show_selected_variant_image and current_variant.metafields.custom.images.value.size > 0 %}
          {% for image in current_variant.metafields.custom.images.value %}
            <div>
              <img src="{{ image | image_url }}" alt="">
            </div>
          {% endfor %}
        {% else %}
          {% for image in product.images %}
            <div>
              <img src="{{ image | image_url }}" alt="">
            </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="product-info">
        <h1 class="product-info__title">{{ product.title }}</h1>
        <div class="product-info__price">{{ current_variant.price | money }}</div>
        <div class="product-info__vendor">{{ product.vendor }}</div>
        {% render 'quantity-input', quantity: 1 %}
        {% render 'variant-picker', product:product %}
      </div>
    </product-info>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.product",
  "tag": "section",
  "class": "section product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings":  [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "Page Size",
      "default": 12,
      "min": 4,
      "max": 48,
      "step": 4
    },
    {
      "type": "checkbox",
      "id": "only_show_selected_variant_image",
      "label": "t:fields.only_show_selected_variant_image",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:fields.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:fields.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    },
    {
      "type": "_buy-buttons"
    },
    {
      "type": "_variant-picker"
    }
  ],
  "presets": [
    {
      "name":  "t:sections.product"
    }
  ]
}
{% endschema %}


