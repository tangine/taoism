{% style %}
  #{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top | append : 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append : 'px' }};
  }
{% endstyle %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
%}


<div id="{{ section.id }}" class="relative">
  <div class="section-inner">
    <product-info data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-selected-variant-id="{{ current_variant.id }}" style="display: grid;grid-template-columns: repeat(2,1fr);">
      <div class="media-gallery">
        {% if section.settings.only_show_selected_variant_image and current_variant.metafields.custom.images.value.size > 0 %}
          {% for image in current_variant.metafields.custom.images.value %}
            <div>
              <img src="{{ image | image_url }}" alt="">
            </div>
          {% endfor %}
        {% else %}
          {% for image in product.images %}
            <div>
              <img src="{{ image | image_url }}" alt="">
            </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="product-info">
        {% content_for 'blocks' %}
      </div>
    </product-info>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.product",
  "tag": "section",
  "class": "section product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings":  [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "only_show_selected_variant_image",
      "label": "t:settings.only_show_selected_variant_image",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    },
    {
      "type": "_product-title"
    },
    {
      "type": "_product-vendor"
    },
    {
      "type": "_buy-buttons"
    },
    {
      "type": "_price"
    },
    {
      "type": "_variant-picker"
    }
  ],
  "presets": [
    {
      "name":  "t:sections.product",
      "blocks": {
        "product_title_rxRU8B": {
          "type": "_product-title",
          "name": "t:blocks.product_title",
          "settings": {
            "alignment": "left"
          },
          "blocks": {}
        },
        "price_xqaPyJ": {
          "type": "_price",
          "name": "t:blocks.price",
          "settings": {},
          "blocks": {}
        },
        "variant_picker_EqitQf": {
          "type": "_variant-picker",
          "name": "t:blocks.variant_picker",
          "settings": {
            "thickness": 1
          },
          "blocks": {}
        },
        "buy_buttons_Lwi7m7": {
          "type": "_buy-buttons",
          "name": "t:blocks.buy_buttons",
          "settings": {},
          "blocks": {}
        }
      },
      "block_order": [
        "product_title_rxRU8B",
        "price_xqaPyJ",
        "variant_picker_EqitQf",
        "buy_buttons_Lwi7m7"
      ]
    }
  ]
}
{% endschema %}


