{% style %}
  #{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top | append : 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append : 'px' }};
  }
{% endstyle %}

{% liquid
%}


<div id="{{ section.id }}" class="relative">
  <div class="section-inner">
    <cart-info>
      {% unless cart.empty %}
        <table>
          <thead>
          <tr>
            <th colspan="2">产品</th>
            <th>价格</th>
            <th>数量</th>
            <th>总计</th>
          </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart-item">
                <td class="cart-item__image">
                  <div>
                    <img src="{{ item.image | image_url }}" alt="" style="object-fit: contain;" width="100" height="100">
                  </div>
                </td>
                <td class="cart-item__info">
                  <div class="cart-item__title">{{ item.title }}</div>
                  <div class="cart-item__price">{{ item.price | money }}</div>
                  <div class="cart-item__options">
                    {% for option_with_value in item.options_with_values %}
                      <div class="cart-item__option">
                        <span class="cart-item__option-name">{{ option_with_value.name }}</span>
                        <span class="cart-item__option-value">{{ option_with_value.value }}</span>
                      </div>
                    {% endfor %}
                  </div>
                </td>
                <td class="cart-item__quantity">{% render 'quantity-input', quantity: item.quantity %}</td>
                <td class="cart-item__total">
                  <div class="cart-item__amount">{{ item.final_line_price | money }}</div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <div>{{ cart.total_price | money }}</div>
      {% endunless %}
    </cart-info>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.cart",
  "tag": "section",
  "class": "section cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings":  [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "only_show_selected_variant_image",
      "label": "t:settings.only_show_selected_variant_image",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name":  "t:sections.cart",
      "blocks": {

      },
      "block_order": [
      ]
    }
  ]
}
{% endschema %}


