{% style %}
  #{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top | append : 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append : 'px' }};
  }
{% endstyle %}

{% liquid
%}


<div id="{{ section.id }}" class="relative">
  <div class="section-inner">
    <cart-info>
      {% for item in cart.items %}
        <cart-item>
          <div>{{ item.title }}</div>
          <div>{{ item.price | money }}</div>
          {% render 'quantity-input', quantity: item.quantity  %}
          <div>{{ item.final_line_price | money }}</div>
        </cart-item>
      {% endfor %}
    </cart-info>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.cart",
  "tag": "section",
  "class": "section cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings":  [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "only_show_selected_variant_image",
      "label": "t:settings.only_show_selected_variant_image",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name":  "t:sections.cart",
      "blocks": {

      },
      "block_order": [
      ]
    }
  ]
}
{% endschema %}


