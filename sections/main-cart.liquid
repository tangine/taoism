{% style %}
  #{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top | append : 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append : 'px' }};
  }
{% endstyle %}

{% liquid
%}


<div id="{{ section.id }}" class="relative">
  <div class="section-inner">
    <cart-info>
      {% unless cart.empty %}
        <table>
          <thead>
          <tr>
            <th class="cart-item__info" colspan="2">产品</th>
            <th class="cart-item__quantity">数量</th>
            <th class="cart-item__total">总计</th>
          </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart-item">
                <td class="cart-item__image">
                  <div>
                    <img src="{{ item.image | image_url }}" alt="" style="object-fit: contain;" width="100" height="100">
                  </div>
                </td>
                <td class="cart-item__info">
                  <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  <div class="cart-item__price">{{ item.price | money }}</div>
                  {% unless item.product.has_only_default_variant %}
                    <div class="cart-item__options">
                      {% for option_with_value in item.options_with_values %}
                        <dl class="cart-item__option">
                          <dt class="cart-item__option-name">{{ option_with_value.name | append: ":" }}</dt>
                          <dd class="cart-item__option-value">{{ option_with_value.value }}</dd>
                        </dl>
                      {% endfor %}
                    </div>
                  {% endunless %}
                </td>
                <td class="cart-item__quantity">
                  <div>
                    <quantity-editor class="quantity"
                      data-index="{{ forloop.index }}"
                      data-variant="{{ item.variant_id }}">
                      <button class="quantity-editor__button quantity-editor__butoon-minus" name="minus" type="button">
                        <span class="svg-wrapper">{{ 'icon-minus.svg' | inline_asset_content }}</span>
                      </button>
                      <input type="number" class="quantity-editor__input" name="quantity" {% unless max == null %} max = "{{ max }}" {% endunless %}
                             data-quantity="{{ quantity }}"
                             value="{{ item.quantity }}"
                             min="1"
                             step="1"
                      />
                      <button class="quantity-editor__button quantity-editor__butoon-plus" name="plus" type="button">
                        <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                      </button>
                    </quantity-editor>
                  </div>
                </td>
                <td class="cart-item__total">
                  <div class="cart-item__amount">{{ item.final_line_price | money }}</div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      <div>{{ cart.total_price | money }}</div>
      {% endunless %}
    </cart-info>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.cart",
  "tag": "section",
  "class": "section cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings":  [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "only_show_selected_variant_image",
      "label": "t:settings.only_show_selected_variant_image",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name":  "t:sections.cart",
      "blocks": {

      },
      "block_order": [
      ]
    }
  ]
}
{% endschema %}


