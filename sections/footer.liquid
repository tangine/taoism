{% style %}
  #{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top | append : 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append : 'px' }};
  }
{% endstyle %}

<div id="{{ section.id }}" class="relative">
  <div class="section-inner">
    <ul class="nav" style="display: flex;flex-direction: row;align-items: center;gap: 10px;">
      {% for link in section.settings.menu.links %}
        <li class="nav-item" data-active="{{ link.active }}">
          <a href="{{ link.url }}">{{- link.title | escape -}}</a>
          {% if link.links != blank %}
            <ul class="sub-menu">
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.footer",
  "tag": "section",
  "class": "section footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings":  [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name":  "t:sections.footer"
    }
  ]
}
{% endschema %}