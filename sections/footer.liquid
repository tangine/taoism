{% style %}
  #{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top | append : 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append : 'px' }};
  }
{% endstyle %}

<div id="{{ section.id }}" class="relative">
  <div class="section-inner"></div>
</div>
{% schema %}
{
  "name": "t:sections.footer",
  "tag": "section",
  "class": "section footer",
  "disabled_on": {
    "groups": ["footer", "footer"]
  },
  "settings":  [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:fields.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:fields.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name":  "t:sections.footer"
    }
  ]
}
{% endschema %}